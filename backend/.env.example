# Copy to .env, supply your own credentials and keep this file private.
OPENAI_API_KEY=replace-with-your-own-openai-api-key
CLIENT_ACCESS_TOKEN=change-this-to-a-long-random-secret
PORT=8787
# Model names are configurable. These are reasonable starting settings.
RESEARCH_MODEL=gpt-6.1-sol
WRITER_MODEL=gpt-6-luna
