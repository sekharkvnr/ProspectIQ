{
  "manifest_version": 3,
  "name": "ProspectIQ AI — Meeting Intelligence",
  "short_name": "ProspectIQ",
  "description": "Prepare for B2B prospect meetings with source-linked company intelligence and tailored discovery questions.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {"default_title": "Open ProspectIQ AI", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
